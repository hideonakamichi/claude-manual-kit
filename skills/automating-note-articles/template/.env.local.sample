# ============================================================================
# .env.local.sample
#   このファイルをコピーして .env.local という名前にし、値を埋める。
#   .env.local は合鍵の束。人に渡さない・チャットに貼らない・zip に入れない。
#   空のままの項目は、その機能が止まるだけ（ほかは動く）。
# ============================================================================

# --- Cloudflare D1（記事の保存先 DB）------------------------------------------
# アカウント ID: Cloudflare のダッシュボード右側（または URL の dash.cloudflare.com/ のあと）
# API トークン: 右上の人のアイコン → プロフィール → API トークン → トークンを作成
#   → カスタム トークン、権限は「アカウント / D1 / 編集」だけ。強いキーなので外に出さない
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Gemini（見出し画像・図解を作る）------------------------------------------
# https://aistudio.google.com/apikey で発行
GEMINI_API_KEY=
# 使う画像モデル。変わったときだけ書き換える
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# --- Jina（Web の下調べ）-----------------------------------------------------
# 推奨。https://jina.ai で無料のキーを作る。検索（出典集め）にはキーが要る
# ページを読むだけならキーなしでも動く（回数が少ない）
JINA_API_KEY=

# --- 通知（編集長の完了報告・自動実行の失敗）-----------------------------------
# 通知先を1つ選んで書き、その欄だけ埋める: gmail / slack / discord / chatwork / line
# 埋めたら python scripts\notify.py test で試しの通知を送り、届くのを確かめる
# 自動実行（run-agent.ps1）は、ここが空だと記事を書かずに止まる
NOTIFY_CHANNEL=

# gmail: Google アカウントの2段階認証をオン → https://myaccount.google.com/apppasswords でアプリ パスワード（16文字）を作る
MAIL_TO=
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# slack: 通知用チャンネルで Incoming Webhook を作り、URL を貼る（無料プランで可。会社の Slack は管理者の許可が要ることがある）
SLACK_WEBHOOK_URL=

# discord: チャンネルの設定 → 連携サービス → ウェブフック → 新しいウェブフック → URL をコピー（無料）
DISCORD_WEBHOOK_URL=

# chatwork: 有料プラン（スタンダード以上）で使える。個人設定 → サービス連携 → API トークン（組織は管理者の承認が要る）
#   ROOM_ID は通知を受けるチャットの URL の #!rid のあとの数字
CHATWORK_API_TOKEN=
CHATWORK_ROOM_ID=

# line: LINE公式アカウントを作り Messaging API を有効にする（無料プランは月200通まで）
#   LINE Developers のチャネルで「チャネルアクセストークン（長期）」と「あなたのユーザーID」をコピー。公式アカウントを自分で友だち追加しておく
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

