{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Write(./work/**)",
      "Edit(./work/**)",
      "Agent(media-writer)",
      "Agent(media-reviewer)",
      "Bash(python scripts/*)"
